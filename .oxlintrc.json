{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "ignorePatterns": [
    "**/dist/**",
    "**/dist-test/**",
    "**/node_modules/**",
    "rust-vexus-lite/**",
    "VectorStoreTDB/**",
    "examples/demo/demo-data/**"
  ],
  "options": {
    "typeAware": true
  },
  "categories": {
    "correctness": "off",
    "nursery": "off",
    "pedantic": "off",
    "perf": "off",
    "restriction": "off",
    "style": "off",
    "suspicious": "off"
  },
  "overrides": [
    {
      "files": ["**/*.ts", "**/*.cts"],
      "rules": {
        "no-unreachable": "error",
        "typescript/no-floating-promises": "error"
      }
    },
    {
      "files": ["tests/**/*.ts"],
      "rules": {
        "typescript/no-floating-promises": "off"
      }
    }
  ]
}
