# Copy this file to tutorials/08-provider-selection/.env.
# Complete EMBED_* values select the OpenAI-compatible embedding provider.
# Base URL of the compatible embedding HTTP service.
EMBED_API_URL=
# Secret/token accepted by that service.
EMBED_API_KEY=
# Embedding model name accepted by that service.
EMBED_MODEL=
# Number of values returned by the model; must match the engine dimension.
EMBED_DIMENSION=
# Optional client-side batch concurrency.
EMBED_CONCURRENCY=5

# Complete RERANK_* values select the OpenAI-compatible reranker.
# Endpoint, token, and model are all required for compatible reranking.
RERANK_API_URL=
RERANK_API_KEY=
RERANK_MODEL=
# Optional request timeout in milliseconds.
RERANK_TIMEOUT_MS=30000
