{
  "name": "memoria",
  "version": "0.1.0",
  "description": "Canonical AI memory engine with semantic, associative, and structural retrieval backed by SQLite and optional Rust acceleration",
  "type": "module",
  "packageManager": "pnpm@11.20.0",
  "main": "./dist/index.cjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./adapters/filesystem": {
      "types": "./dist/adapters/filesystem-ingestion-adapter.d.ts",
      "import": "./dist/adapters/filesystem-ingestion-adapter.js"
    },
    "./errors": {
      "types": "./dist/errors.d.ts",
      "import": "./dist/errors.js"
    },
    "./providers/openai-compatible": {
      "types": "./dist/providers/openai-compatible.d.ts",
      "import": "./dist/providers/openai-compatible.js"
    }
  },
  "files": [
    "dist",
    "rust-vexus-lite/index.js",
    "rust-vexus-lite/index.d.ts",
    "rust-vexus-lite/package.json",
    "rust-vexus-lite/*.node",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "license": "MIT",
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "oxlint src tests tutorials scripts --type-aware --deny-warnings",
    "build": "tsc -p tsconfig.build.json",
    "build:test": "tsc -p tsconfig.test.json",
    "tutorial:01": "corepack pnpm build:test && node dist-test/tutorials/01-first-memory/main.js",
    "tutorial:02": "corepack pnpm build:test && node dist-test/tutorials/02-mdx-filesystem/main.js",
    "tutorial:03": "corepack pnpm build:test && node dist-test/tutorials/03-search-and-scope/main.js",
    "tutorial:04": "corepack pnpm build:test && node dist-test/tutorials/04-retrieval-plans/main.js",
    "tutorial:05": "corepack pnpm build:test && node dist-test/tutorials/05-expansion-and-reranking/main.js",
    "tutorial:06": "corepack pnpm build:test && node dist-test/tutorials/06-persistence-and-maintenance/main.js",
    "tutorial:07": "corepack pnpm build:test && node dist-test/tutorials/07-tdb/main.js",
    "tutorial:08": "corepack pnpm build:test && node dist-test/tutorials/08-provider-selection/main.js",
    "tutorials:run": "corepack pnpm build:test && node scripts/run-tutorials.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "verify:docs": "node scripts/verify-docs.mjs && node scripts/verify-tutorials.mjs",
    "typecheck:public": "corepack pnpm build && tsc -p tsconfig.public.json --noEmit",
    "test": "corepack pnpm build && corepack pnpm build:test && node --test dist-test/tests/algorithms/*.test.js dist-test/tests/algorithms/tag-graph/*.test.js dist-test/tests/adapters/*.test.js dist-test/tests/core/*.test.js dist-test/tests/engine/*.test.js dist-test/tests/integration/*.test.js dist-test/tests/pipelines/*.test.js dist-test/tests/providers/*.test.js dist-test/tests/retrieval/*.test.js dist-test/tests/stages/*.test.js dist-test/tests/tdb/*.test.js dist-test/tests/utils/*.test.js dist-test/tests/consumer/*.test.js",
    "test:native": "corepack pnpm build:test && node --test dist-test/tests/core/test-load-native.test.js dist-test/tests/providers/test-vexus-vector-store.test.js",
    "verify:public": "corepack pnpm typecheck:public && corepack pnpm test:native",
    "verify:pack": "corepack pnpm build && node scripts/verify-packed-consumer.mjs"
  },
  "dependencies": {
    "@dqbd/tiktoken": "^1.0.22",
    "better-sqlite3": "^12.4.1",
    "chokidar": "^3.5.3",
    "yaml": "2.8.1"
  },
  "engines": {
    "node": ">=24.18.1 <25"
  },
  "devDependencies": {
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "24.13.3",
    "oxlint": "1.77.0",
    "oxlint-tsgolint": "7.0.2001",
    "prettier": "3.9.6",
    "typescript": "7.0.2"
  }
}
