# DashScope 密钥（https://dashscope.console.aliyun.com 获取）
EMBED_API_KEY=sk-xxxxxxxxxxxxxxxx
# 可选：默认 qwen3.7-text-embedding / 1024 维 / 并发 4
# EMBED_MODEL=qwen3.7-text-embedding
# EMBED_DIMENSION=1024
# EMBED_API_URL=https://dashscope.aliyuncs.com/api/v1/services/embeddings/text-embedding/text-embedding
# EMBED_CONCURRENCY=4

# 只有传入 --external-rerank 时才需要配置以下三项
# RERANK_API_URL=https://your-openai-compatible-host/v1/chat/completions
# RERANK_API_KEY=sk-xxxxxxxxxxxxxxxx
# RERANK_MODEL=your-reranker-model
# RERANK_TIMEOUT_MS=30000
